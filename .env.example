# Environment Variables Template - The Lenny Growth Assistant
# Copy to .env and configure for your local environment

# Database Configuration (PostgreSQL 18)
DATABASE_URL=postgresql+psycopg://postgres:Anu1116@localhost:5432/lenny_growth

# Model Provider Selection: "ollama", "pi-agent", "anthropic", or "openai"
LLM_PROVIDER=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional Cloud Providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
